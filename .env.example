# Copy to .env and fill in. Nested settings use a double underscore.
# Every value can also be set as a plain environment variable.

EVIDENTIA_ENVIRONMENT=local
EVIDENTIA_LOG_JSON=false
EVIDENTIA_LOG_LEVEL=INFO
# EVIDENTIA_CORS_ORIGINS=["http://localhost:3000"]

# --- core infrastructure (docker-compose sets these for containers) ----------------
EVIDENTIA_DATABASE__URL=postgresql+asyncpg://evidentia:evidentia@localhost:5432/evidentia
EVIDENTIA_REDIS__URL=redis://localhost:6379/0

# --- auth & secrets -----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# EVIDENTIA_AUTH__JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EVIDENTIA_SECURITY__ENCRYPTION_KEYS=["<fernet-key>"]

# --- model provider ("fake" runs fully offline) -------------------------------------
EVIDENTIA_LLM__PROVIDER=fake
# EVIDENTIA_LLM__OPENAI_API_KEY=
EVIDENTIA_LLM__REASONING_MODEL=gpt-5.4
EVIDENTIA_LLM__CHAT_MODEL=gpt-5-mini
EVIDENTIA_LLM__EMBEDDING_MODEL=text-embedding-3-small

# --- object storage (S3-compatible) -------------------------------------------------
EVIDENTIA_STORAGE__BUCKET=evidentia-documents
EVIDENTIA_STORAGE__REGION=eu-central-1
EVIDENTIA_STORAGE__ENDPOINT_URL=http://localhost:9000
EVIDENTIA_STORAGE__ACCESS_KEY_ID=evidentia
EVIDENTIA_STORAGE__SECRET_ACCESS_KEY=evidentia-local-secret

# --- integrations (optional) --------------------------------------------------------
# EVIDENTIA_CARDS__BIN_LOOKUP_URL=
# EVIDENTIA_CARDS__BIN_LOOKUP_API_KEY=
# EVIDENTIA_CRM__WEBHOOK_URL=
# EVIDENTIA_CRM__API_KEY=

# --- observability ------------------------------------------------------------------
EVIDENTIA_OBSERVABILITY__METRICS_ENABLED=true
# EVIDENTIA_OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4318

# --- agent access (MCP) -------------------------------------------------------------
EVIDENTIA_MCP__ENABLED=false
# EVIDENTIA_MCP__SERVICE_TOKEN=
